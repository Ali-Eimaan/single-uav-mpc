# Fly N laps of a trajectory and report tracking statistics. Consumed by the SITL smoke test
# and by the analysis sweeps.
#
# NOTE: not wired into nmpc_node in v0.1 — the interface is generated so downstream packages
# (transition-viable-swarm) can already compile against it.

# --- goal ---
TrajectorySpec spec
int32 laps                         # 0 => run until cancelled
float64 timeout                    # [s] abort if exceeded; 0 => no timeout
---
# --- result ---
bool success
string message
float64 rms_position_error         # [m] over the whole run
float64 max_position_error         # [m]
float64 median_solve_time_ms
float64 p99_solve_time_ms
int32 solver_failures
float64 flight_time                # [s]
---
# --- feedback ---
int32 laps_completed
float64 progress                   # [0, 1] within the current lap
float64 current_position_error     # [m]
float64 current_solve_time_ms
